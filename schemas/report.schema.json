{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://akasha.library/schemas/report.schema.json",
  "title": "Daily Report",
  "description": "每日館報的最終 JSON 輸出。對應規格 §11.2 與 §17.1。",
  "type": "object",
  "required": [
    "reportId",
    "date",
    "timezone",
    "generated_at",
    "status",
    "warnings",
    "sections",
    "stats"
  ],
  "additionalProperties": false,
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^daily_\\d{8}$",
      "description": "格式：daily_YYYYMMDD。"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Taipei"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "message"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "source_failed",
              "tier1_partial_failed",
              "section_empty",
              "lint_warning",
              "other"
            ]
          },
          "source_id": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beat", "title", "emoji", "items"],
        "additionalProperties": false,
        "properties": {
          "beat": {
            "type": "string",
            "enum": ["INTL", "ARTS", "AI", "ECON", "PTS_LOCAL", "TW_STORY"]
          },
          "title": { "type": "string" },
          "emoji": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "$ref": "platform_output.schema.json"
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "total_feeds_checked",
        "total_feeds_failed",
        "total_articles_fetched",
        "total_articles_after_filter",
        "total_events_merged",
        "total_events_selected",
        "tw_highlights_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_feeds_checked": { "type": "integer", "minimum": 0 },
        "total_feeds_failed": { "type": "integer", "minimum": 0 },
        "total_articles_fetched": { "type": "integer", "minimum": 0 },
        "total_articles_after_filter": { "type": "integer", "minimum": 0 },
        "total_events_merged": { "type": "integer", "minimum": 0 },
        "total_events_selected": { "type": "integer", "minimum": 0 },
        "tw_highlights_count": { "type": "integer", "minimum": 0 }
      }
    },
    "voiceTaskId": { "type": ["string", "null"] },
    "bgmScoreId": { "type": ["string", "null"] },
    "dropped_events": {
      "type": "array",
      "description": "未選入但曾進入候選池的事件，記錄 drop_reason（規格 §8.3）。",
      "items": {
        "type": "object",
        "required": ["event_id", "headline", "selection_score", "drop_reason"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string" },
          "headline": { "type": "string" },
          "selection_score": { "type": "number" },
          "drop_reason": { "type": "string" }
        }
      }
    }
  }
}
